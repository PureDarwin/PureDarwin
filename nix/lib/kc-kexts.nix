# The kext set that goes into the boot kernel collection, in link order.
#
# Shared so the image's KC and the guest's pd-rebuild-kc cannot drift: adding a
# kext in one place and not the other produces a KC that boots on one path and
# not the other, which is painful to diagnose.
[
    "corecrypto.kext"
    "pthread.kext"
    "amfi.kext"
    "IOACPIFamily.kext"
    "PDACPIPlatform.kext"
    "IOPCIFamily.kext"
    "AppleAPIC.kext"
    #"AppleI386GenericPlatform.kext"
    "AppleI386PCI.kext"
    "IOStorageFamily.kext"
    "IONVMEFamily.kext"
    "IOATAFamily.kext"
    "AppleIntelPIIXATA.kext"
    "IOATABlockStorage.kext"
    "ext4.kext"
    "msdosfs.kext"
    "apfs.kext"
    "HFSEncodings.kext"
    "hfs.kext"
    "AppleFileSystemDriver.kext"
    "Ext4FileSystemDriver.kext"
    "IOHIDFamily.kext"
    "ApplePS2Controller.kext"
    "IOUSBFamily.kext"
    "IOUSBCompositeDriver.kext"
    "AppleUSBMergeNub.kext"
    "IOUSBHIDDriver.kext"
    "AppleUSBEHCI.kext"
    "AppleUSBOHCI.kext"
    "AppleUSBUHCI.kext"
    "RavynAHCIPort.kext"
    "RavynXHCIPort.kext"
    "IOGraphicsFamily.kext"
    "IOGOPFramebuffer.kext"
    "IONetworkingFamily.kext"
    "IOVirtIOFamily.kext"
    "IOVirtIOGPU.kext"
    "IOVirtIONet.kext"
    "IOVirtIOBlock.kext"
    "IOIntelFramebuffer.kext"
    "PDE1000.kext"
    "PDRealtek8111.kext"
    "IOAudioFamily.kext"
    "RavynHDAudio.kext"
]
