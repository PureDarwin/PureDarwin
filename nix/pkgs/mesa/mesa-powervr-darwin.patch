+
+static int pco_live_interval_cmp(const void *pa, const void *pb)
+{
+   const struct pco_live_interval *a = pa, *b = pb;
+   if (a->start != b->start) return a->start < b->start ? -1 : 1;
+   /* Points precede nonempty ranges at the same start. */
+   if (a->end != b->end) return a->end < b->end ? -1 : 1;
+   return a->var < b->var ? -1 : a->var != b->var;
+}
+
+static void pco_live_interference(struct ra_graph *graph,
+                                  const struct live_range *ranges,
+                                  unsigned num_vars)
+{
+   struct pco_live_interval *intervals =
+      ralloc_array(graph, struct pco_live_interval, num_vars);
+   unsigned count = 0;
+   for (unsigned var = 0; var < num_vars; ++var) {
+      if (ranges[var].start == ~0U) continue;
+      intervals[count++] = (struct pco_live_interval){ var, ranges[var].start, ranges[var].end };
+   }
+   if (count < 2) {
+      ralloc_free(intervals);
+      return;
+   }
+   qsort(intervals, count, sizeof(*intervals), pco_live_interval_cmp);
+   unsigned *active = ralloc_array(graph, unsigned, count);
+   unsigned nactive = 0;
+   for (unsigned i = 0; i < count; ++i) {
+      const struct pco_live_interval *cur = &intervals[i];
+      unsigned retained = 0;
+      for (unsigned j = 0; j < nactive; ++j) {
+         const struct pco_live_interval *prev = &intervals[active[j]];
+         if (prev->end <= cur->start) continue;
+         active[retained++] = active[j];
+         unsigned v0 = MIN2(prev->var, cur->var), v1 = MAX2(prev->var, cur->var);
+         /* Preserve the original endpoint predicate, including point ranges. */
+         if (ranges[v1].end != ~0U && prev->start < cur->end)
+            ra_add_node_interference(graph, v0, v1);
+      }
+      nactive = retained;
+      active[nactive++] = i;
+   }
+   ralloc_free(active);
+   ralloc_free(intervals);
+}
