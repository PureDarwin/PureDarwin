+   unsigned char digest[SHA1_DIGEST_LENGTH];
+};
+
+static const char *pd_pco_cache_directory(void)
+{
+   const char *dir = getenv("PD_PVR_SHADER_CACHE");
+#ifdef __APPLE__
+   if (!dir) {
+      mkdir("/var/db/airjitd", 0700);
+      dir = "/var/db/airjitd/pco";
+   }
+#endif
+   if (!dir || !*dir || !strcmp(dir, "0"))
+      return NULL;
+   if (mkdir(dir, 0700) && errno != EEXIST)
+      return NULL;
+   return dir;
+}
+
+static void pd_pco_scalar_data(pco_data *out, const pco_data *in)
+{
+   *out = *in;
+   for (unsigned i = 0; i < PVR_MAX_DESCRIPTOR_SETS; ++i)
+      out->common.desc_sets[i].bindings = NULL;
+}
+
+static bool pd_pco_cache_key(struct pvr_device *device, nir_shader *nir,
+                             const pco_data *data, char path[512])
+{
+   const char *dir = pd_pco_cache_directory();
+   if (!dir || pco_shader_cache_debug_enabled())
+      return false;
+   struct blob blob;
+   blob_init(&blob);
+   nir_serialize(&blob, nir, true);
+   if (blob.out_of_memory) {
+      blob_finish(&blob);
+      return false;
+   }
+   struct mesa_sha1 ctx;
+   unsigned char digest[SHA1_DIGEST_LENGTH];
+   char hex[SHA1_DIGEST_LENGTH * 2 + 1];
+   pco_data scalar;
+   pd_pco_scalar_data(&scalar, data);
+   uint64_t bvnc = pvr_get_packed_bvnc(&device->pdevice->dev_info);
+   const uint32_t version = 1;
+   _mesa_sha1_init(&ctx);
+   _mesa_sha1_update(&ctx, &version, sizeof(version));
+   _mesa_sha1_update(&ctx, device->pdevice->instance->driver_build_sha, SHA1_DIGEST_LENGTH);
+   _mesa_sha1_update(&ctx, &bvnc, sizeof(bvnc));
+   _mesa_sha1_update(&ctx, blob.data, blob.size);
+   _mesa_sha1_update(&ctx, &scalar, sizeof(scalar));
+   for (unsigned i = 0; i < PVR_MAX_DESCRIPTOR_SETS; ++i) {
+      const pco_descriptor_set_data *set = &data->common.desc_sets[i];
+      if (set->binding_count)
+         _mesa_sha1_update(&ctx, set->bindings, set->binding_count * sizeof(*set->bindings));
+   }
+   _mesa_sha1_final(&ctx, digest);
+   _mesa_sha1_format(hex, digest);
+   blob_finish(&blob);
+   int n = snprintf(path, 512, "%s/%s.bin", dir, hex);
+   return n > 0 && n < 512;
+}
+
+static pco_shader *pd_pco_cache_load(const char *path, pco_ctx *ctx,
+                                     nir_shader *nir, const pco_data *input,
+                                     void *mem_ctx)
+{
+   int fd = open(path, O_RDONLY | O_NOFOLLOW);
+   if (fd < 0)
+      return NULL;
+   struct stat st;
+   struct pd_pco_cache_header h;
+   pco_data stored;
+   unsigned char *binary = NULL;
+   pco_shader *shader = NULL;
+   if (fstat(fd, &st) || !S_ISREG(st.st_mode) ||
+       read(fd, &h, sizeof(h)) != sizeof(h) ||
+       h.magic != 0x5044434f || h.version != 1 || h.data_size != sizeof(stored) ||
+       !h.binary_size || h.binary_size > PD_PCO_CACHE_MAX ||
+       (uint64_t)st.st_size != sizeof(h) + sizeof(stored) + h.binary_size ||
+       read(fd, &stored, sizeof(stored)) != sizeof(stored))
+      goto out;
+   binary = malloc(h.binary_size);
+   if (!binary)
+      goto out;
+   size_t done = 0;
+   while (done < h.binary_size) {
+      ssize_t n = read(fd, binary + done, h.binary_size - done);
+      if (n < 0 && errno == EINTR) continue;
+      if (n <= 0) goto out;
+      done += n;
+   }
+   struct mesa_sha1 sha;
+   unsigned char digest[SHA1_DIGEST_LENGTH];
+   _mesa_sha1_init(&sha);
+   _mesa_sha1_update(&sha, &stored, sizeof(stored));
+   _mesa_sha1_update(&sha, binary, h.binary_size);
+   _mesa_sha1_final(&sha, digest);
+   if (memcmp(digest, h.digest, sizeof(digest)))
+      goto out;
+   for (unsigned i = 0; i < PVR_MAX_DESCRIPTOR_SETS; ++i) {
+      if (stored.common.desc_sets[i].bindings ||
+          stored.common.desc_sets[i].binding_count != input->common.desc_sets[i].binding_count)
+         goto out;
+      stored.common.desc_sets[i].bindings = input->common.desc_sets[i].bindings;
+   }
+   shader = pco_shader_from_binary(ctx, nir, &stored, binary, h.binary_size, mem_ctx);
+   if (!shader) goto out;
+   mesa_logd("PD PCO cache hit: %s", path);
+out:
+   free(binary);
+   close(fd);
+   return shader;
+}
+
+static void pd_pco_cache_store(const char *path, pco_shader *shader)
+{
+   size_t size = pco_shader_binary_size(shader);
+   if (!size || size > PD_PCO_CACHE_MAX)
+      return;
+   pco_data data;
+   pd_pco_scalar_data(&data, pco_shader_data(shader));
+   struct pd_pco_cache_header h = {0x5044434f, 1, sizeof(data), size, {0}};
+   struct mesa_sha1 sha;
+   _mesa_sha1_init(&sha);
+   _mesa_sha1_update(&sha, &data, sizeof(data));
+   _mesa_sha1_update(&sha, pco_shader_binary_data(shader), size);
+   _mesa_sha1_final(&sha, h.digest);
+   char tmp[544];
+   snprintf(tmp, sizeof(tmp), "%s.XXXXXX", path);
+   int fd = mkstemp(tmp);
+   if (fd < 0) return;
+   const void *parts[] = {&h, &data, pco_shader_binary_data(shader)};
+   size_t sizes[] = {sizeof(h), sizeof(data), size};
+   bool ok = true;
+   for (unsigned i = 0; i < 3 && ok; ++i) {
+      size_t done = 0;
+      while (done < sizes[i]) {
+         ssize_t n = write(fd, (const char *)parts[i] + done, sizes[i] - done);
+         if (n < 0 && errno == EINTR) continue;
+         if (n <= 0) { ok = false; break; }
+         done += n;
+      }
+   }
+   if (close(fd)) ok = false;
+   if (ok) ok = !rename(tmp, path);
+   if (!ok) unlink(tmp);
+}
+
+static pco_shader *pd_pco_compile(struct pvr_device *device, pco_ctx *ctx,
+                                   nir_shader *nir, pco_data *data, void *mem_ctx)
+{
+   char path[512];
+   bool cache = pd_pco_cache_key(device, nir, data, path);
+   pco_shader *shader = cache ? pd_pco_cache_load(path, ctx, nir, data, mem_ctx) : NULL;
+   if (shader) return shader;
+   shader = pco_trans_nir(ctx, nir, data, mem_ctx);
+   if (!shader) return NULL;
+   pco_process_ir(ctx, shader);
+   pco_encode_ir(ctx, shader);
+   if (cache) pd_pco_cache_store(path, shader);
+   return shader;
+}
 
