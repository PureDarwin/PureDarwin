+// mach-o reaches a thread local through its descriptor, whose first word is a
+// thunk taking the descriptor in a0 and returning the variable's address in a0
+SDValue RISCVTargetLowering::getDarwinTLSAddr(GlobalAddressSDNode *N,
+                                              SelectionDAG &DAG) const {
+  SDLoc DL(N);
+  MVT PtrVT = getPointerTy(DAG.getDataLayout());
+  MachineFunction &MF = DAG.getMachineFunction();
+  const GlobalValue *GV = N->getGlobal();
+
+  SDValue Sym = DAG.getTargetGlobalAddress(GV, DL, PtrVT, 0, 0);
+  SDValue DescAddr =
+      SDValue(DAG.getMachineNode(RISCV::PseudoLA_TLVP, DL, PtrVT, Sym), 0);
+
+  // the thunk pointer never changes once the image is bound
+  SDValue Chain = DAG.getEntryNode();
+  SDValue Thunk = DAG.getLoad(
+      PtrVT, DL, Chain, DescAddr, MachinePointerInfo::getGOT(MF),
+      Align(PtrVT.getSizeInBits() / 8),
+      MachineMemOperand::MOInvariant | MachineMemOperand::MODereferenceable);
+  Chain = Thunk.getValue(1);
+
+  MF.getFrameInfo().setAdjustsStack(true);
+  Chain = DAG.getCALLSEQ_START(Chain, 0, 0, DL);
+  SDValue Glue;
+  Chain = DAG.getCopyToReg(Chain, DL, RISCV::X10, DescAddr, Glue);
+  Glue = Chain.getValue(1);
+
+  const auto *TRI = Subtarget.getRegisterInfo();
+  SDValue Ops[] = {Chain, Thunk, DAG.getRegister(RISCV::X10, PtrVT),
+                   DAG.getRegisterMask(TRI->getDarwinTLSCallPreservedMask()),
+                   Glue};
+  Chain = DAG.getNode(RISCVISD::CALL, DL, DAG.getVTList(MVT::Other, MVT::Glue),
+                      Ops);
+  Glue = Chain.getValue(1);
+  Chain = DAG.getCALLSEQ_END(Chain, 0, 0, Glue, DL);
+  Glue = Chain.getValue(1);
+  return DAG.getCopyFromReg(Chain, DL, RISCV::X10, PtrVT, Glue);
+}
