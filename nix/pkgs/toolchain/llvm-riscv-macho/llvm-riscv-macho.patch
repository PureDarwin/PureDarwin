+
+RISCVMCAsmInfoDarwin::RISCVMCAsmInfoDarwin(const Triple &TT) {
+  CodePointerSize = CalleeSaveStackSlotSize = TT.isArch64Bit() ? 8 : 4;
+  PrivateGlobalPrefix = "L";
+  PrivateLabelPrefix = "L";
+  CommentString = "#";
+  SeparatorString = ";";
+  AlignmentIsInBytes = false;
+  UsesELFSectionDirectiveForBSS = true;
+  SupportsDebugInformation = true;
+  ExceptionsType = ExceptionHandling::DwarfCFI;
+  UseAtForSpecifier = true;
+  Data16bitsDirective = "\t.half\t";
+  Data32bitsDirective = "\t.word\t";
+  initializeAtSpecifiers({{RISCV::S_MACHO_GOT, "GOT"}});
+}
+
+void RISCVMCAsmInfoDarwin::printSpecifierExpr(
+    raw_ostream &OS, const MCSpecifierExpr &Expr) const {
+  auto S = Expr.getSpecifier();
+  bool HasSpecifier = S != 0 && S != ELF::R_RISCV_CALL_PLT;
+  if (HasSpecifier)
+    OS << '%' << RISCV::getSpecifierName(S) << '(';
+  printExpr(OS, *Expr.getSubExpr());
+  if (HasSpecifier)
+    OS << ')';
+}
+
+// the cie's personality is an indirect pc-relative pointer, sym@GOT - .
+const MCExpr *RISCVMCAsmInfoDarwin::getExprForPersonalitySymbol(
+    const MCSymbol *Sym, unsigned Encoding, MCStreamer &Streamer) const {
+  MCContext &Context = Streamer.getContext();
+  const MCExpr *Res = MCSymbolRefExpr::create(Sym, RISCV::S_MACHO_GOT, Context);
+  MCSymbol *PCSym = Context.createTempSymbol();
+  Streamer.emitLabel(PCSym);
+  const MCExpr *PC = MCSymbolRefExpr::create(PCSym, Context);
+  return MCBinaryExpr::createSub(Res, PC, Context);
+}
