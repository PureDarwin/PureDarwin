diff --git a/lib/Target/RISCV/MCTargetDesc/RISCVMachObjectWriter.cpp b/lib/Target/RISCV/MCTargetDesc/RISCVMachObjectWriter.cpp
new file mode 100644
index 000000000..a3d1858ef
--- /dev/null
+++ b/lib/Target/RISCV/MCTargetDesc/RISCVMachObjectWriter.cpp
@@ -0,0 +1,331 @@
+//===-- RISCVMachObjectWriter.cpp - RISC-V Mach-O Writer ------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// relocations follow the riscv model in ld64: extern symbols only for code,
+// addends in a leading RISCV_RELOC_ADDEND, and a pc-relative LO12 whose own
+// immediate holds the offset back to the AUIPC it pairs with
+//
+//===----------------------------------------------------------------------===//
+
+#include "MCTargetDesc/RISCVFixupKinds.h"
+#include "MCTargetDesc/RISCVMCAsmInfo.h"
+#include "MCTargetDesc/RISCVMCTargetDesc.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/BinaryFormat/MachO.h"
+#include "llvm/MC/MCAsmInfoDarwin.h"
+#include "llvm/MC/MCAssembler.h"
+#include "llvm/MC/MCContext.h"
+#include "llvm/MC/MCExpr.h"
+#include "llvm/MC/MCFixup.h"
+#include "llvm/MC/MCMachObjectWriter.h"
+#include "llvm/MC/MCSection.h"
+#include "llvm/MC/MCSectionMachO.h"
+#include "llvm/MC/MCSymbol.h"
+#include "llvm/MC/MCValue.h"
+#include "llvm/Support/Casting.h"
+#include "llvm/Support/MathExtras.h"
+
+using namespace llvm;
+
+namespace {
+
+class RISCVMachObjectWriter : public MCMachObjectTargetWriter {
+public:
+  RISCVMachObjectWriter(uint32_t CPUType, uint32_t CPUSubtype, bool Is64Bit)
+      : MCMachObjectTargetWriter(Is64Bit, CPUType, CPUSubtype) {}
+
+  void recordRelocation(MachObjectWriter *Writer, MCAssembler &Asm,
+                        const MCFragment *Fragment, const MCFixup &Fixup,
+                        MCValue Target, uint64_t &FixedValue) override;
+
+private:
+  void addReloc(MachObjectWriter *Writer, const MCFragment *Fragment,
+                uint32_t Offset, const MCSymbol *RelSymbol, unsigned Index,
+                bool PCRel, unsigned Log2Size, unsigned Type) {
+    MachO::any_relocation_info MRE;
+    MRE.r_word0 = Offset;
+    MRE.r_word1 = (Index << 0) | (unsigned(PCRel) << 24) | (Log2Size << 25) |
+                  (Type << 28);
+    Writer->addRelocation(RelSymbol, Fragment->getParent(), MRE);
+  }
+};
+
+} // end anonymous namespace
+
+// the auipc fixup a %pcrel_lo names, and the fragment it lives in
+static const MCFixup *findPCRelHi(const MCFixup &LoFixup,
+                                  const MCFragment **DFOut,
+                                  uint64_t *OffsetOut) {
+  const auto *Expr = dyn_cast<MCSpecifierExpr>(LoFixup.getValue());
+  if (!Expr)
+    return nullptr;
+  MCValue AUIPCLoc;
+  if (!Expr->getSubExpr()->evaluateAsRelocatable(AUIPCLoc, nullptr))
+    return nullptr;
+  const MCSymbol *AUIPCSymbol = AUIPCLoc.getAddSym();
+  if (!AUIPCSymbol)
+    return nullptr;
+  const auto *DF = dyn_cast_or_null<MCDataFragment>(AUIPCSymbol->getFragment());
+  if (!DF)
+    return nullptr;
+
+  uint64_t Offset = AUIPCSymbol->getOffset();
+  if (DF->getContents().size() == Offset) {
+    DF = dyn_cast_or_null<MCDataFragment>(DF->getNext());
+    if (!DF)
+      return nullptr;
+    Offset = 0;
+  }
+
+  for (const MCFixup &F : DF->getFixups()) {
+    if (F.getOffset() != Offset)
+      continue;
+    if (F.getKind() == RISCV::fixup_riscv_pcrel_hi20 ||
+        F.getKind() == ELF::R_RISCV_GOT_HI20 ||
+        F.getKind() == RISCV::S_MACHO_TLVP_HI) {
+      *DFOut = DF;
+      *OffsetOut = Offset;
+      return &F;
+    }
+    break;
+  }
+  return nullptr;
+}
+
+void RISCVMachObjectWriter::recordRelocation(
+    MachObjectWriter *Writer, MCAssembler &Asm, const MCFragment *Fragment,
+    const MCFixup &Fixup, MCValue Target, uint64_t &FixedValue) {
+  uint32_t FixupOffset = Asm.getFragmentOffset(*Fragment) + Fixup.getOffset();
+  unsigned Kind = Fixup.getKind();
+  bool PCRel = false;
+  unsigned Log2Size = 2;
+  unsigned Type;
+  // instruction relocations keep the immediate clear, their addend rides in RISCV_RELOC_ADDEND
+  bool InstReloc = true;
+  // the value a pc-relative LO12 leaves in its instruction, the distance back to the AUIPC
+  int64_t InstImm = 0;
+
+  if (mc::isRelocation(Kind)) {
+    switch (Kind) {
+    case ELF::R_RISCV_GOT_HI20:
+      Type = MachO::RISCV_RELOC_HI20_GOT;
+      PCRel = true;
+      break;
+    case RISCV::S_MACHO_TLVP_HI:
+      Type = MachO::RISCV_RELOC_TLVP_LOAD_HI20;
+      PCRel = true;
+      break;
+    default:
+      reportError(Fixup.getLoc(), "relocation type " + Twine(Kind) +
+                                      " not supported in RISC-V Mach-O");
+      return;
+    }
+  } else {
+    switch (Kind) {
+    case FK_Data_4:
+    case FK_Data_8:
+      InstReloc = false;
+      Log2Size = Kind == FK_Data_8 ? 3 : 2;
+      Type = MachO::RISCV_RELOC_UNSIGNED;
+      break;
+    case RISCV::fixup_riscv_jal:
+      Type = MachO::RISCV_RELOC_BRANCH20;
+      PCRel = true;
+      break;
+    case RISCV::fixup_riscv_hi20:
+      Type = MachO::RISCV_RELOC_HI20;
+      break;
+    case RISCV::fixup_riscv_lo12_i:
+    case RISCV::fixup_riscv_lo12_s:
+      Type = MachO::RISCV_RELOC_LO12;
+      break;
+    case RISCV::fixup_riscv_pcrel_hi20:
+      Type = MachO::RISCV_RELOC_HI20;
+      PCRel = true;
+      break;
+    case RISCV::fixup_riscv_pcrel_lo12_i:
+    case RISCV::fixup_riscv_pcrel_lo12_s: {
+      // the relocation names what the auipc names, found through the label
+      const MCFragment *HiDF;
+      uint64_t HiOffset;
+      const MCFixup *Hi = findPCRelHi(Fixup, &HiDF, &HiOffset);
+      if (!Hi) {
+        reportError(Fixup.getLoc(), "could not find corresponding %pcrel_hi");
+        return;
+      }
+      MCValue HiTarget;
+      if (!Hi->getValue()->evaluateAsRelocatable(HiTarget, &Asm)) {
+        reportError(Fixup.getLoc(), "invalid %pcrel_hi expression");
+        return;
+      }
+      if (Hi->getKind() == ELF::R_RISCV_GOT_HI20)
+        Type = MachO::RISCV_RELOC_LO12_GOT;
+      else if (Hi->getKind() == RISCV::S_MACHO_TLVP_HI)
+        Type = MachO::RISCV_RELOC_TLVP_LOAD_LO12;
+      else
+        Type = MachO::RISCV_RELOC_LO12;
+      PCRel = true;
+      Target = HiTarget;
+      InstImm = int64_t(Asm.getFragmentOffset(*HiDF) + HiOffset) -
+                int64_t(FixupOffset);
+      if (!isInt<12>(InstImm)) {
+        reportError(Fixup.getLoc(),
+                    "%pcrel_lo is too far from its %pcrel_hi for Mach-O");
+        return;
+      }
+      break;
+    }
+    case RISCV::fixup_riscv_call:
+    case RISCV::fixup_riscv_call_plt:
+      reportError(Fixup.getLoc(),
+                  "RISC-V Mach-O calls use jal, ld64 has no auipc+jalr pair");
+      return;
+    default:
+      reportError(Fixup.getLoc(), "fixup needs a relocation RISC-V Mach-O "
+                                  "cannot express, use a local label");
+      return;
+    }
+  }
+
+  int64_t Value = Target.getConstant();
+
+  if (Target.isAbsolute()) {
+    if (PCRel) {
+      reportError(Fixup.getLoc(), "pc-relative relocation of an absolute value");
+      return;
+    }
+    // symbolnum 0 with r_extern clear is the absolute section
+    FixedValue = Value;
+    addReloc(Writer, Fragment, FixupOffset, nullptr, 0, false, Log2Size,
+             MachO::RISCV_RELOC_UNSIGNED);
+    return;
+  }
+
+  // sym@GOT - . is a 32-bit pc-relative pointer to the slot, sym@GOT alone an absolute one
+  if (Target.getSpecifier() == RISCV::S_MACHO_GOT) {
+    const MCSymbol *A = Target.getAddSym();
+    const MCSymbol *B = Target.getSubSym();
+    bool AtPC = B && Asm.getSymbolOffset(*B) == FixupOffset;
+    if (InstReloc || Value || (B && !AtPC) || (!B && Log2Size != 3) ||
+        (B && Log2Size != 2)) {
+      reportError(Fixup.getLoc(), "unsupported GOT reference, use sym@GOT - .");
+      return;
+    }
+    FixedValue = 0;
+    addReloc(Writer, Fragment, FixupOffset, A, 0, B != nullptr, Log2Size,
+             MachO::RISCV_RELOC_POINTER_TO_GOT);
+    return;
+  }
+  if (Target.getSpecifier() != 0 && !InstReloc) {
+    reportError(Fixup.getLoc(), "unsupported relocation of modified symbol");
+    return;
+  }
+
+  if (const MCSymbol *B = Target.getSubSym()) {
+    // a - b, as SUBTRACTOR b followed by UNSIGNED a in the file
+    const MCSymbol *A = Target.getAddSym();
+    if (InstReloc || PCRel) {
+      reportError(Fixup.getLoc(), "unsupported relocation of a difference");
+      return;
+    }
+    // __eh_frame holds only temporary labels, so a side with no atom goes into
+    // the symbol table as a local and the relocation names it directly
+    const MCSymbol *ABase = Writer->getAtom(*A);
+    const MCSymbol *BBase = Writer->getAtom(*B);
+    if (!ABase && A->isInSection()) {
+      A->setUsedInReloc();
+      ABase = A;
+    }
+    if (!BBase && B->isInSection()) {
+      B->setUsedInReloc();
+      BBase = B;
+    }
+    if (!ABase || !BBase) {
+      reportError(Fixup.getLoc(), "difference of undefined local symbols");
+      return;
+    }
+    if (ABase == BBase) {
+      reportError(Fixup.getLoc(), "unsupported relocation with identical base");
+      return;
+    }
+    Value += (A->getFragment() ? Writer->getSymbolAddress(*A) : 0) -
+             (ABase->getFragment() ? Writer->getSymbolAddress(*ABase) : 0);
+    Value -= (B->getFragment() ? Writer->getSymbolAddress(*B) : 0) -
+             (BBase->getFragment() ? Writer->getSymbolAddress(*BBase) : 0);
+    // relocations come out reversed, so the pair reads SUBTRACTOR then UNSIGNED
+    addReloc(Writer, Fragment, FixupOffset, ABase, 0, false, Log2Size,
+             MachO::RISCV_RELOC_UNSIGNED);
+    addReloc(Writer, Fragment, FixupOffset, BBase, 0, false, Log2Size,
+             MachO::RISCV_RELOC_SUBTRACTOR);
+    FixedValue = Value;
+    return;
+  }
+
+  const MCSymbol *Symbol = Target.getAddSym();
+  const auto &Section = static_cast<const MCSectionMachO &>(*Fragment->getParent());
+  const MCSymbol *RelSymbol = nullptr;
+  unsigned Index = 0;
+
+  // literal sections split by content, so a label there must reach the symbol table
+  if (Symbol->isTemporary() && Symbol->isInSection() &&
+      !MCAsmInfoDarwin::isSectionAtomizableBySymbols(Symbol->getSection()))
+    Symbol->setUsedInReloc();
+
+  const MCSymbol *Base = Writer->getAtom(*Symbol);
+  if (Symbol->isInSection() && Section.hasAttribute(MachO::S_ATTR_DEBUG))
+    Base = nullptr;
+
+  if (Base) {
+    RelSymbol = Base;
+    if (Base != Symbol)
+      Value += Asm.getSymbolOffset(*Symbol) - Asm.getSymbolOffset(*Base);
+  } else if (!Symbol->isInSection() || Symbol->isUsedInReloc() ||
+             !Symbol->isTemporary()) {
+    // undefined, or a local that made it into the symbol table
+    RelSymbol = Symbol;
+  } else if (!InstReloc) {
+    // pointers may use a section-relative relocation
+    Index = Symbol->getSection().getOrdinal() + 1;
+    Value += Writer->getSymbolAddress(*Symbol);
+  } else {
+    Symbol->setUsedInReloc();
+    RelSymbol = Symbol;
+  }
+
+  if (!InstReloc) {
+    FixedValue = Value;
+    addReloc(Writer, Fragment, FixupOffset, RelSymbol, Index, PCRel, Log2Size,
+             Type);
+    return;
+  }
+
+  // a tlv descriptor is referenced whole
+  if (Value && (Type == MachO::RISCV_RELOC_TLVP_LOAD_HI20 ||
+                Type == MachO::RISCV_RELOC_TLVP_LOAD_LO12)) {
+    reportError(Fixup.getLoc(), "thread local variable reference with an addend");
+    return;
+  }
+
+  // the main relocation first, then its addend, which the reversed file order puts ahead
+  addReloc(Writer, Fragment, FixupOffset, RelSymbol, Index, PCRel, 2, Type);
+  if (Value) {
+    if (!isInt<24>(Value)) {
+      reportError(Fixup.getLoc(), "addend too big for relocation");
+      return;
+    }
+    addReloc(Writer, Fragment, FixupOffset, nullptr, uint32_t(Value) & 0xffffff,
+             false, 2, MachO::RISCV_RELOC_ADDEND);
+  }
+  FixedValue = InstImm;
+}
+
+std::unique_ptr<MCObjectTargetWriter>
+llvm::createRISCVMachObjectWriter(uint32_t CPUType, uint32_t CPUSubtype,
+                                  bool Is64Bit) {
+  return std::make_unique<RISCVMachObjectWriter>(CPUType, CPUSubtype, Is64Bit);
+}
