diff --git a/lib/Target/RISCV/RISCVMachOPCRelLo.cpp b/lib/Target/RISCV/RISCVMachOPCRelLo.cpp
new file mode 100644
index 000000000..d4b16086c
--- /dev/null
+++ b/lib/Target/RISCV/RISCVMachOPCRelLo.cpp
@@ -0,0 +1,235 @@
+//===-- RISCVMachOPCRelLo.cpp - Keep %pcrel_lo near its auipc on Mach-O ---===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// a mach-o %pcrel_lo keeps the distance back to its auipc in a 12-bit immediate,
+// so users that might sit past 2KB get their own auipc and near ones keep sharing
+//
+//===----------------------------------------------------------------------===//
+
+#include "MCTargetDesc/RISCVBaseInfo.h"
+#include "RISCV.h"
+#include "RISCVInstrInfo.h"
+#include "RISCVSubtarget.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/CodeGen/LivePhysRegs.h"
+#include "llvm/CodeGen/MachineFunctionPass.h"
+#include "llvm/CodeGen/MachineInstrBuilder.h"
+#include "llvm/CodeGen/MachineRegisterInfo.h"
+#include "llvm/MC/MCContext.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "riscv-macho-pcrel-lo"
+#define RISCV_MACHO_PCREL_LO_NAME "RISC-V Mach-O %pcrel_lo reach"
+
+namespace {
+
+// worst case bytes, below the 2048 the immediate reaches
+constexpr int64_t PCRelLoReach = 1984;
+
+class RISCVMachOPCRelLo : public MachineFunctionPass {
+public:
+  static char ID;
+  RISCVMachOPCRelLo() : MachineFunctionPass(ID) {}
+
+  bool runOnMachineFunction(MachineFunction &MF) override;
+
+  MachineFunctionProperties getRequiredProperties() const override {
+    return MachineFunctionProperties().setNoVRegs();
+  }
+
+  StringRef getPassName() const override { return RISCV_MACHO_PCREL_LO_NAME; }
+
+private:
+  // worst case layout, plus how many inline asm blocks lie before each point
+  struct Pos {
+    int64_t Offset;
+    unsigned AsmBefore;
+  };
+  DenseMap<const MachineInstr *, Pos> Layout;
+  const RISCVInstrInfo *TII = nullptr;
+
+  void computeLayout(MachineFunction &MF);
+  bool mayBeFar(const MachineInstr &Hi, const MachineInstr &Lo) const;
+  Register pickRegister(MachineInstr &Lo, Register Base);
+  bool baseLiveOut(MachineBasicBlock &MBB, Register Base) const;
+  bool fixOnce(MachineFunction &MF);
+};
+
+} // end anonymous namespace
+
+char RISCVMachOPCRelLo::ID = 0;
+
+INITIALIZE_PASS(RISCVMachOPCRelLo, DEBUG_TYPE, RISCV_MACHO_PCREL_LO_NAME,
+                false, false)
+
+void RISCVMachOPCRelLo::computeLayout(MachineFunction &MF) {
+  Layout.clear();
+  int64_t Offset = 0;
+  unsigned Asm = 0;
+  for (MachineBasicBlock &MBB : MF) {
+    // alignment padding, at most the alignment itself
+    Offset += MBB.getAlignment().value();
+    for (MachineInstr &MI : MBB) {
+      Layout[&MI] = {Offset, Asm};
+      Offset += TII->getInstSizeInBytes(MI);
+      // branch relaxation may still grow a branch into a longer sequence
+      if (MI.isBranch())
+        Offset += 8;
+      if (MI.isInlineAsm())
+        ++Asm;
+    }
+  }
+}
+
+bool RISCVMachOPCRelLo::mayBeFar(const MachineInstr &Hi,
+                                 const MachineInstr &Lo) const {
+  auto H = Layout.find(&Hi), L = Layout.find(&Lo);
+  if (H == Layout.end() || L == Layout.end())
+    return true;
+  // inline asm has no trustworthy size, .fill alone can be any length
+  if (H->second.AsmBefore != L->second.AsmBefore)
+    return true;
+  int64_t Dist = L->second.Offset - H->second.Offset;
+  return Dist > PCRelLoReach || Dist < -PCRelLoReach;
+}
+
+// a register the new auipc may write just before Lo
+Register RISCVMachOPCRelLo::pickRegister(MachineInstr &Lo, Register Base) {
+  const TargetRegisterInfo *TRI = Lo.getMF()->getSubtarget().getRegisterInfo();
+  const MachineRegisterInfo &MRI = Lo.getMF()->getRegInfo();
+  // a load or addi overwrites its destination anyway, so the auipc can use it
+  if (Lo.getNumOperands() && Lo.getOperand(0).isReg() &&
+      Lo.getOperand(0).isDef()) {
+    Register Dst = Lo.getOperand(0).getReg();
+    if (RISCV::GPRRegClass.contains(Dst) && Dst != RISCV::X0)
+      return Dst;
+  }
+  // stores and fp loads need a free gpr
+  MachineBasicBlock &MBB = *Lo.getParent();
+  LivePhysRegs Live(*TRI);
+  Live.addLiveOuts(MBB);
+  for (MachineInstr &MI : llvm::reverse(MBB)) {
+    Live.stepBackward(MI);
+    if (&MI == &Lo)
+      break;
+  }
+  for (MCPhysReg R : RISCV::GPRRegClass) {
+    if (R == RISCV::X0 || MRI.isReserved(R) || !Live.available(MRI, R))
+      continue;
+    if (Lo.readsRegister(R, TRI) || Lo.modifiesRegister(R, TRI))
+      continue;
+    return R;
+  }
+  return Register();
+}
+
+bool RISCVMachOPCRelLo::baseLiveOut(MachineBasicBlock &MBB,
+                                    Register Base) const {
+  const TargetRegisterInfo *TRI = MBB.getParent()->getSubtarget().getRegisterInfo();
+  LivePhysRegs Live(*TRI);
+  Live.addLiveOuts(MBB);
+  return Live.contains(Base);
+}
+
+bool RISCVMachOPCRelLo::fixOnce(MachineFunction &MF) {
+  DenseMap<const MCSymbol *, MachineInstr *> HiFor;
+  for (MachineBasicBlock &MBB : MF)
+    for (MachineInstr &MI : MBB)
+      if (MI.getOpcode() == RISCV::AUIPC && MI.getPreInstrSymbol())
+        HiFor[MI.getPreInstrSymbol()] = &MI;
+  if (HiFor.empty())
+    return false;
+
+  computeLayout(MF);
+  bool Changed = false;
+  for (MachineBasicBlock &MBB : MF) {
+    for (MachineInstr &Lo : MBB) {
+      for (MachineOperand &MO : Lo.operands()) {
+        if (!MO.isMCSymbol() || MO.getTargetFlags() != RISCVII::MO_PCREL_LO)
+          continue;
+        auto It = HiFor.find(MO.getMCSymbol());
+        if (It == HiFor.end())
+          continue;
+        MachineInstr &Hi = *It->second;
+        if (!mayBeFar(Hi, Lo))
+          continue;
+
+        // the base register sits right before the %pcrel_lo in loads, stores and addi,
+        // and it may be a copy of the auipc's result rather than the register it wrote
+        unsigned Idx = MO.getOperandNo();
+        if (Idx == 0 || !Lo.getOperand(Idx - 1).isReg() ||
+            Lo.getOperand(Idx - 1).isDef())
+          report_fatal_error("unexpected %pcrel_lo user on RISC-V Mach-O");
+        MachineOperand *BaseUse = &Lo.getOperand(Idx - 1);
+        Register Base = BaseUse->getReg();
+        MCSymbol *OldSym = MO.getMCSymbol();
+
+        // when the user reads the auipc's own register and nothing past this block does,
+        // recompute it here and the users after this one in the block share the new auipc
+        if (Base == Hi.getOperand(0).getReg() && !baseLiveOut(MBB, Base)) {
+          MCSymbol *Sym = MF.getContext().createNamedTempSymbol("pcrel_hi");
+          MachineInstr *NewHi =
+              BuildMI(MBB, Lo, Lo.getDebugLoc(), TII->get(RISCV::AUIPC), Base)
+                  .add(Hi.getOperand(1));
+          NewHi->setPreInstrSymbol(MF, Sym);
+          const TargetRegisterInfo *TRI = MF.getSubtarget().getRegisterInfo();
+          for (MachineBasicBlock::iterator I(Lo), E = MBB.end(); I != E; ++I) {
+            for (MachineOperand &Op : I->operands()) {
+              if (!Op.isMCSymbol() || Op.getMCSymbol() != OldSym ||
+                  Op.getTargetFlags() != RISCVII::MO_PCREL_LO)
+                continue;
+              // only users that read this register see the new auipc's value
+              unsigned J = Op.getOperandNo();
+              if (J && I->getOperand(J - 1).isReg() &&
+                  I->getOperand(J - 1).getReg() == Base)
+                Op.ChangeToMCSymbol(Sym, RISCVII::MO_PCREL_LO);
+            }
+            if (I->modifiesRegister(Base, TRI))
+              break;
+          }
+          // the new auipc must not take the old one's kill of the base
+          BaseUse->setIsKill(false);
+          return true;
+        }
+
+        Register R = pickRegister(Lo, Base);
+        if (!R)
+          report_fatal_error("no free register to repeat an auipc for a far "
+                             "%pcrel_lo on RISC-V Mach-O");
+
+        MCSymbol *Sym = MF.getContext().createNamedTempSymbol("pcrel_hi");
+        MachineInstr *NewHi =
+            BuildMI(MBB, Lo, Lo.getDebugLoc(), TII->get(RISCV::AUIPC), R)
+                .add(Hi.getOperand(1));
+        NewHi->setPreInstrSymbol(MF, Sym);
+        BaseUse->setReg(R);
+        BaseUse->setIsKill(false);
+        MO.ChangeToMCSymbol(Sym, RISCVII::MO_PCREL_LO);
+        Changed = true;
+      }
+    }
+  }
+  return Changed;
+}
+
+bool RISCVMachOPCRelLo::runOnMachineFunction(MachineFunction &MF) {
+  const RISCVSubtarget &STI = MF.getSubtarget<RISCVSubtarget>();
+  if (!STI.getTargetTriple().isOSBinFormatMachO())
+    return false;
+  TII = STI.getInstrInfo();
+  bool Changed = false;
+  // each new auipc moves later code, so settle until nothing is out of reach
+  while (fixOnce(MF))
+    Changed = true;
+  return Changed;
+}
+
+FunctionPass *llvm::createRISCVMachOPCRelLoPass() {
+  return new RISCVMachOPCRelLo();
+}
