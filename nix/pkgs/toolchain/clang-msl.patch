# Metal Shading Language rules for mslc, behind the cc1 flag -fmsl: a scalar converts to a vector's element type
# whatever their ranks, and class operands of ?: may differ in address space

--- a/clang/include/clang/Basic/LangOptions.def
+++ b/clang/include/clang/Basic/LangOptions.def
@@ -243,6 +243,7 @@
 LANGOPT(NoGPULib  , 1, 0, NotCompatible, "Indicate a build without the standard GPU libraries.")
 
 LANGOPT(HLSL, 1, 0, NotCompatible, "HLSL")
+LANGOPT(MSL, 1, 0, NotCompatible, "Metal Shading Language rules on top of C++ for OpenCL")
 ENUM_LANGOPT(HLSLVersion, HLSLLangStd, 16, HLSL_Unset, NotCompatible, "HLSL Version")
 LANGOPT(HLSLStrictAvailability, 1, 0, NotCompatible,
         "Strict availability diagnostic mode for HLSL built-in functions.")

--- a/clang/include/clang/Driver/Options.td
+++ b/clang/include/clang/Driver/Options.td
@@ -8522,6 +8522,9 @@
   HelpText<"Include default header file for OpenCL and HLSL">;
 def fdeclare_opencl_builtins : Flag<["-"], "fdeclare-opencl-builtins">,
   HelpText<"Add OpenCL builtin function declarations (experimental)">;
+def fmsl : Flag<["-"], "fmsl">,
+  HelpText<"Metal Shading Language rules on top of C++ for OpenCL">,
+  MarshallingInfoFlag<LangOpts<"MSL">>;
 
 def fhlsl_strict_availability : Flag<["-"], "fhlsl-strict-availability">,
   HelpText<"Enables strict availability diagnostic mode for HLSL built-in functions.">,

