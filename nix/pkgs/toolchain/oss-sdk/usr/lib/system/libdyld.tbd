               __ZNK8objc_opt13objc_clsopt_t20getClassNameForIndexEj,
               __ZNK8objc_opt13objc_clsopt_t22getClassHeaderAndIndexEPKcRPvS4_Rj,
               __ZNK8objc_opt13objc_selopt_t14getIndexForKeyEPKc,
               __ZNK8objc_opt13objc_selopt_t16getEntryForIndexEj,
               __ZNK8objc_opt13objc_selopt_t16getSentinelIndexEv,
               __ZNK8objc_opt13objc_selopt_t3getEPKc,
