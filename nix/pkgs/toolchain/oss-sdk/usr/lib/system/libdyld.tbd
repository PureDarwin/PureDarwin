--- !tapi-tbd
tbd-version: 4
targets: [ x86_64-macos, arm64-macos ]
install-name: '/usr/lib/system/libdyld.dylib'
current-version: 1292.100.5
compatibility-version: 1
# libSystem.B.dylib re-exports this by absolute path, so ld has to be able to
# resolve it from the sysroot; without it every -lSystem link needs its own
# -Wl,-dylib_file. Mirrors libdyld.dylib's exports (llvm-nm --defined-only).
exports:
  - targets: [ x86_64-macos, arm64-macos ]
    symbols: [
               __availability_version_check, __Block_copy, __Block_copy_collectable,
               __Block_extended_layout, __Block_has_signature, __Block_isDeallocating,
               __Block_layout, __Block_object_assign, __Block_object_dispose,
               __Block_release, __Block_signature, _Block_size, __Block_tryRetain,
               __Block_use_RR2, __Block_use_stret, _bootstrap_port, _cerror,
               _cerror_nocancel, __cpu_capabilities, __cpu_has_altivec, _dispatch_once_f,
               _dladdr, _dlclose, _dlerror, _dlopen, _dlopen_audited, _dlopen_from,
               _dlopen_preflight, _dlsym, __dyld_all_twolevel_modules_prebound,
               __dyld_atfork_parent, __dyld_atfork_prepare,
               __dyld_bind_fully_image_containing_address, _dyld_dynamic_interpose,
               __dyld_find_unwind_sections, __dyld_for_each_objc_class,
               __dyld_for_each_objc_protocol, __dyld_fork_child, __dyld_func_lookup,
               _dyld_get_active_platform, _dyld_get_base_platform,
               __dyld_get_image_header, __dyld_get_image_header_containing_address,
               __dyld_get_image_name, __dyld_get_image_slide, __dyld_get_image_uuid,
               _dyld_get_image_versions, __dyld_get_image_vmaddr_slide,
               _dyld_get_min_os_version, __dyld_get_objc_selector,
               __dyld_get_prog_image_header, _dyld_get_program_min_os_version,
               _dyld_get_program_sdk_version, _dyld_get_sdk_version,
               __dyld_get_shared_cache_range, __dyld_get_shared_cache_uuid,
               __dyld_has_fix_for_radar, _dyld_has_inserted_or_interposing_libraries,
               __dyld_image_containing_address, __dyld_image_count,
               _dyld_image_header_containing_address,
               _dyld_image_path_containing_address, __dyld_images_for_addresses,
               __dyld_initializer, __dyld_is_memory_immutable, __dyld_is_objc_constant,
               _dyld_is_simulator_platform, __dyld_launched_prebound, __dyld_launch_mode,
