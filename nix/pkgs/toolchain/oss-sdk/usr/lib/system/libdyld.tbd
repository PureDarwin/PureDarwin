               __dyld_register_for_image_loads, __dyld_register_func_for_add_image,
               __dyld_register_func_for_remove_image, _dyld_sdk_at_least,
               __dyld_shared_cache_contains_path, _dyld_shared_cache_file_path,
               _dyld_shared_cache_find_iterate_text,
               __dyld_shared_cache_is_locally_built, _dyld_shared_cache_iterate_text,
               __dyld_shared_cache_optimized, __dyld_shared_cache_real_path,
