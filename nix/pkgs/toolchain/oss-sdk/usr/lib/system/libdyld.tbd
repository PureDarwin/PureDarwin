               __Z27setNotifyMonitoringDyldMainPFvvE, __ZN5dyld315internalInstallEv,
               __ZN5dyld316compatFuncLookupEPKcPPv,
               __ZN5dyld317forEachLineInFileEPKcmU13block_pointerFvS1_RbE,
               __ZN5dyld317forEachLineInFileEPKcU13block_pointerFvS1_RbE,
               __ZN5dyld318entryVectorForDyldE,
               __ZN5dyld324greaterThanAddOrOverflowIjEEbjjT_,
               __ZN5dyld324greaterThanAddOrOverflowImEEbyyT_,
               __ZN5dyld324greaterThanAddOrOverflowIyEEbyyT_,
               __ZN5dyld33MapIybNS_7closure10HashUInt64ENS1_11EqualUInt64EE3endEv,
               __ZN5dyld33MapIybNS_7closure10HashUInt64ENS1_11EqualUInt64EE4findERKy,
               __ZN5dyld33MapIybNS_7closure10HashUInt64ENS1_11EqualUInt64EE6insertEONSt3__14pairIybEE,
               __ZN5dyld33MapIybNS_7closure10HashUInt64ENS1_11EqualUInt64EEixEy,
