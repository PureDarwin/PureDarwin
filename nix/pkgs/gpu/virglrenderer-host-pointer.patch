 }
 
+#include <sys/mman.h>
+
+#include "util/anon_file.h"
+
+static bool
+vkr_shm_get_host_pointer_info(const VkMemoryAllocateInfo *alloc_info,
+                              int *out_fd,
+                              void **out_ptr,
+                              size_t *out_size,
+                              VkImportMemoryHostPointerInfoEXT *out_info)
+{
+   const size_t size = align(alloc_info->allocationSize, getpagesize());
+   int fd = os_create_anonymous_file(size, "vkr-shm");
+   if (fd < 0) {
+      vkr_log("shm file failed (%s)", strerror(errno));
+      return false;
+   }
+
+   void *ptr = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+   if (ptr == MAP_FAILED) {
+      vkr_log("shm mmap failed (%s)", strerror(errno));
+      close(fd);
+      return false;
+   }
+
+   *out_fd = fd;
+   *out_ptr = ptr;
+   *out_size = size;
+   *out_info = (VkImportMemoryHostPointerInfoEXT){
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+      .pNext = alloc_info->pNext,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+      .pHostPointer = ptr,
+   };
+   return true;
+}
+
