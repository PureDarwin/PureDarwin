+/* a layer drawn here and shown in another process's window: its CAContext id, 0 where Core Animation cannot */
+unsigned int macdrv_metal_layer_export(macdrv_metal_layer l, void **context)
+{
+    CALayer* layer = (CALayer*)l;
+    __block unsigned int context_id = 0;
+    __block id ctx = nil;
+
+    OnMainThread(^{
+        Class cls = NSClassFromString(@"CAContext");
+
+        if (cls && (ctx = [cls performSelector:@selector(remoteContext)]))
+        {
+            [ctx retain];
+            [ctx setValue:layer forKey:@"layer"];
+            context_id = [[ctx valueForKey:@"contextId"] unsignedIntValue];
+        }
+    });
+    *context = ctx;
+    return context_id;
+}
+
+void macdrv_release_layer_context(void *context)
+{
+    id ctx = (id)context;
+
+    OnMainThread(^{
+        [ctx release];
+    });
+}
+
+/* the owner side: the view shows another process's layer by its context id */
+void macdrv_view_host_layer(macdrv_view v, unsigned int context_id)
+{
+    NSView* view = (NSView*)v;
+
+    OnMainThread(^{
+        Class cls = NSClassFromString(@"CALayerHost");
+        CALayer* host = [[cls alloc] init];
+
+        if (!host) return;
+        [host setValue:[NSNumber numberWithUnsignedInt:context_id] forKey:@"contextId"];
+        view.layer = host;
+        view.wantsLayer = YES;
+        [host release];
+    });
+}
