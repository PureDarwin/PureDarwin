+/* views showing layers other processes draw into our child windows, kept to follow those windows as they move */
+struct remote_host
+{
+    HWND        hwnd;
+    HWND        toplevel;
+    macdrv_view view;
+};
+static struct remote_host remote_hosts[64];
+static pthread_mutex_t remote_hosts_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+/* the hosted window's client area in the toplevel's content view */
+static BOOL remote_host_rect(HWND hwnd, HWND toplevel, struct macdrv_win_data *data, RECT *rect)
+{
+    if (!NtUserGetClientRect(hwnd, rect, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI))) return FALSE;
+    NtUserMapWindowPoints(hwnd, toplevel, (POINT *)rect, 2, NtUserGetWinMonitorDpi(toplevel, MDT_RAW_DPI));
+    OffsetRect(rect, data->rects.client.left - data->rects.visible.left, data->rects.client.top - data->rects.visible.top);
+    return TRUE;
+}
+
+/* a layer another process draws for one of our windows: a view at the window's client area hosts it */
+void macdrv_host_remote_layer(HWND hwnd, UINT context_id)
+{
+    HWND toplevel = NtUserGetAncestor(hwnd, GA_ROOT);
+    struct macdrv_win_data *data;
+    macdrv_view view, old = NULL;
+    RECT rect;
+    int i, slot = -1;
+
+    TRACE("hwnd %p context %u\n", hwnd, context_id);
+
+    if (!(data = get_win_data(toplevel))) return;
+    if (!remote_host_rect(hwnd, toplevel, data, &rect))
+    {
+        release_win_data(data);
+        return;
+    }
+    view = macdrv_create_view(cgrect_from_rect(rect));
+    macdrv_view_host_layer(view, context_id);
+    macdrv_set_view_superview(view, toplevel == hwnd ? NULL : data->client_view, data->cocoa_window, NULL, NULL);
+    release_win_data(data);
+
+    /* a new context for the same window, after its GPU process started over, takes the old view's place */
+    pthread_mutex_lock(&remote_hosts_mutex);
+    for (i = 0; i < ARRAY_SIZE(remote_hosts); i++)
+    {
+        if (remote_hosts[i].hwnd == hwnd) { slot = i; old = remote_hosts[i].view; break; }
+        if (!remote_hosts[i].hwnd && slot < 0) slot = i;
+    }
+    if (slot >= 0) remote_hosts[slot] = (struct remote_host){ hwnd, toplevel, view };
+    pthread_mutex_unlock(&remote_hosts_mutex);
+    if (old) macdrv_dispose_view(old);
+}
+
+/* the hosted views under a toplevel, moved to where their windows are now */
+static void update_remote_hosts(HWND toplevel)
+{
+    struct macdrv_win_data *data;
+    RECT rect;
+    int i;
+
+    if (!(data = get_win_data(toplevel))) return;
+    pthread_mutex_lock(&remote_hosts_mutex);
+    for (i = 0; i < ARRAY_SIZE(remote_hosts); i++)
+    {
+        struct remote_host *host = &remote_hosts[i];
+
+        if (!host->hwnd || host->toplevel != toplevel) continue;
+        if (!NtUserIsWindow(host->hwnd))
+        {
+            macdrv_dispose_view(host->view);
+            memset(host, 0, sizeof(*host));
+        }
+        else if (remote_host_rect(host->hwnd, toplevel, data, &rect))
+            macdrv_set_view_frame(host->view, cgrect_from_rect(rect));
+    }
+    pthread_mutex_unlock(&remote_hosts_mutex);
+    release_win_data(data);
+}
