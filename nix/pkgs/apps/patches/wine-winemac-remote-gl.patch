+
+/* a window of another process has no cocoa view here, its owner shows what we render, as it does for its own windows */
+static const struct client_surface_funcs remote_client_funcs =
+{
+    .destroy = remote_client_destroy,
+    .detach = remote_client_detach,
+    .update = remote_client_update,
+    .present = remote_client_present,
+};
+
+static void remote_frame_name(HWND hwnd, char *name, size_t size)
+{
+    snprintf(name, size, "/winemacgl.%u.%lx", getuid(), (unsigned long)(ULONG_PTR)hwnd);
+}
+
+static void remote_update_size(struct gl_drawable *gl)
+{
+    HWND hwnd = gl->base.client->hwnd;
+    RECT rect;
+
+    NtUserGetClientRect(hwnd, &rect, NtUserGetDpiForWindow(hwnd));
+    gl->width = max(rect.right - rect.left, 1);
+    gl->height = max(rect.bottom - rect.top, 1);
+}
+
+static void remote_unmap_frame(struct gl_drawable *gl)
+{
+    if (gl->frame) munmap(gl->frame, gl->frame_size);
+    gl->frame = NULL;
+    gl->frame_size = 0;
+}
+
+/* a fresh object per size, darwin sizes a shm object only once */
+static BOOL remote_map_frame(struct gl_drawable *gl, size_t size)
+{
+    char name[64];
+    void *map;
+    int fd;
+
+    if (gl->frame && gl->frame_size == size) return TRUE;
+    remote_unmap_frame(gl);
+
+    remote_frame_name(gl->base.client->hwnd, name, sizeof(name));
+    shm_unlink(name);
+    if ((fd = shm_open(name, O_RDWR | O_CREAT | O_EXCL, 0600)) < 0)
+    {
+        WARN("shm_open %s failed, errno %d\n", name, errno);
+        return FALSE;
+    }
+    if (ftruncate(fd, size) || (map = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0)) == MAP_FAILED)
+    {
+        WARN("sizing %s to %zu failed, errno %d\n", name, size, errno);
+        close(fd);
+        shm_unlink(name);
+        return FALSE;
+    }
+    close(fd);
+
+    gl->frame = map;
+    gl->frame_size = size;
+    return TRUE;
+}
+
+static BOOL remote_surface_create(HWND hwnd, int format, struct opengl_drawable **drawable)
+{
+    struct client_surface *client;
+    struct gl_drawable *gl;
+
+    TRACE("offscreen drawable for hwnd %p, format %d\n", hwnd, format);
+
+    if (!(client = client_surface_create(sizeof(*client), &remote_client_funcs, hwnd))) return FALSE;
+    gl = opengl_drawable_create(sizeof(*gl), &macdrv_remote_funcs, format, client);
+    client_surface_release(client);
+    if (!gl) return FALSE;
+
+    remote_update_size(gl);
+    *drawable = &gl->base;
+    return TRUE;
+}
+
+static void remote_surface_destroy(struct opengl_drawable *base)
+{
+    struct gl_drawable *gl = impl_from_opengl_drawable(base);
+    char name[64];
+
+    TRACE("drawable %s\n", debugstr_opengl_drawable(base));
+
+    if (!gl->frame) return;
+    remote_unmap_frame(gl);
+    remote_frame_name(base->client->hwnd, name, sizeof(name));
+    shm_unlink(name);
+}
+
+static void remote_surface_flush(struct opengl_drawable *base, UINT flags)
+{
+    struct macdrv_context *context = NtCurrentTeb()->glReserved2;
+
+    TRACE("%s flags %#x\n", debugstr_opengl_drawable(base), flags);
+
+    if (context && (flags & GL_FLUSH_UPDATED)) make_context_current(context, FALSE);
+}
+
+/* read the frame back into shared memory and tell the window's owner to draw it */
+static BOOL remote_surface_swap(struct opengl_drawable *base)
+{
+    struct gl_drawable *gl = impl_from_opengl_drawable(base);
+    struct macdrv_context *context = NtCurrentTeb()->glReserved2;
+    HWND hwnd = base->client->hwnd;
+    GLint read_fbo = 0, read_buffer = GL_BACK;
+
+    TRACE("%s context %p\n", debugstr_opengl_drawable(base), context);
+
+    if (!context) return FALSE;
+    if (!remote_map_frame(gl, sizeof(*gl->frame) + (size_t)gl->width * gl->height * 4)) return FALSE;
+
+    pglGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_fbo);
+    if (read_fbo) pglBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    pglGetIntegerv(GL_READ_BUFFER, &read_buffer);
+    pglReadBuffer(GL_BACK);
+    pglReadPixels(0, 0, gl->width, gl->height, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, gl->frame + 1);
+    pglReadBuffer(read_buffer);
+    if (read_fbo) pglBindFramebuffer(GL_READ_FRAMEBUFFER, read_fbo);
+
+    gl->frame->width = gl->width;
+    gl->frame->height = gl->height;
+    if (!InterlockedExchange(&gl->frame->pending, 1))
+        NtUserPostMessage(hwnd, WM_MACDRV_PRESENT_REMOTE_FRAME, 0, 0);
+
+    remote_update_size(gl);
+    if (context->draw_remote == gl) make_context_current(context, FALSE);
+    return TRUE;
+}
+
+/* the owner side shows a frame in a view over the client area, where a gl view would sit,
+   gdi drawing there is clipped away once the window has a pixel format */
+static struct
+{
+    HWND hwnd;
+    struct macdrv_client_surface *client;
+} remote_views[32];
+static pthread_mutex_t remote_views_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static struct macdrv_client_surface *remote_view_for(HWND hwnd)
+{
+    struct macdrv_client_surface *client = NULL;
+    int i, free_slot = -1;
+
+    pthread_mutex_lock(&remote_views_lock);
+    for (i = 0; i < ARRAY_SIZE(remote_views); i++)
+    {
+        if (remote_views[i].hwnd == hwnd) client = remote_views[i].client;
+        else if (!remote_views[i].hwnd && free_slot < 0) free_slot = i;
+    }
+    if (!client && free_slot >= 0 && (client = macdrv_client_surface_create(hwnd)))
+    {
+        remote_views[free_slot].hwnd = hwnd;
+        remote_views[free_slot].client = client;
+    }
+    pthread_mutex_unlock(&remote_views_lock);
+    return client;
+}
+
+void macdrv_present_remote_frame(HWND hwnd)
+{
+    struct macdrv_remote_frame *frame;
+    struct macdrv_client_surface *client;
+    CGColorSpaceRef space;
+    CGDataProviderRef provider;
+    CFMutableDataRef pixels;
+    CGImageRef image;
+    char name[64];
+    struct stat st;
+    size_t row, y;
+    UINT8 *dst;
+    void *map;
+    int fd;
+
+    remote_frame_name(hwnd, name, sizeof(name));
+    if ((fd = shm_open(name, O_RDWR)) < 0) return;
+    if (fstat(fd, &st) || st.st_size < sizeof(*frame) ||
+        (map = mmap(NULL, st.st_size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0)) == MAP_FAILED)
+    {
+        close(fd);
+        return;
+    }
+    close(fd);
+
+    frame = map;
+    InterlockedExchange(&frame->pending, 0);
+    row = (size_t)frame->width * 4;
+    if (!frame->width || sizeof(*frame) + row * frame->height > st.st_size || !(client = remote_view_for(hwnd)))
+    {
+        munmap(map, st.st_size);
+        return;
+    }
+
+    /* glReadPixels rows are bottom-up, images are top-down */
+    pixels = CFDataCreateMutable(NULL, row * frame->height);
+    CFDataSetLength(pixels, row * frame->height);
+    dst = CFDataGetMutableBytePtr(pixels);
+    for (y = 0; y < frame->height; y++)
+        memcpy(dst + y * row, (UINT8 *)(frame + 1) + (frame->height - 1 - y) * row, row);
+
+    provider = CGDataProviderCreateWithCFData(pixels);
+    space = CGColorSpaceCreateDeviceRGB();
+    image = CGImageCreate(frame->width, frame->height, 8, 32, row, space,
+                          kCGBitmapByteOrder32Little | kCGImageAlphaNoneSkipFirst, provider, NULL, FALSE,
+                          kCGRenderingIntentDefault);
+    munmap(map, st.st_size);
+
+    if (image) macdrv_set_view_image(client->cocoa_view, image);
+    CGImageRelease(image);
+    CGColorSpaceRelease(space);
+    CGDataProviderRelease(provider);
+    CFRelease(pixels);
+}
