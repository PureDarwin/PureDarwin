 /***********************************************************************
+ *              macdrv_set_view_image
+ *
+ * Show an image as a view's content, the way a frame rendered in another
+ * place reaches the screen.
+ */
+void macdrv_set_view_image(macdrv_view v, CGImageRef image)
+{
+@autoreleasepool
+{
+    NSView* view = (NSView*)v;
+
+    CGImageRetain(image);
+    OnMainThreadAsync(^{
+        [view setWantsLayer:YES];
+        view.layer.contents = (id)image;
+        [view setNeedsDisplay:YES];
+        CGImageRelease(image);
+    });
+}
+}
