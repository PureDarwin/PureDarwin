-static BOOL use_VK_EXT_metal_surface;
+
+// the loader exports every surface entry point, so ask it which surface extensions an icd provides
+static BOOL host_has_instance_extension(void *vulkan_handle, const char *name)
+{
+    PFN_vkEnumerateInstanceExtensionProperties enumerate = dlsym(vulkan_handle, "vkEnumerateInstanceExtensionProperties");
+    VkExtensionProperties *props;
+    uint32_t i, count = 0;
+    BOOL found = FALSE;
+
+    if (!enumerate || enumerate(NULL, &count, NULL) || !(props = malloc(count * sizeof(*props)))) return FALSE;
+    if (!enumerate(NULL, &count, props))
+    {
+        for (i = 0; i < count; i++) if (!strcmp(props[i].extensionName, name)) found = TRUE;
+    }
+    free(props);
+    return found;
+}
 
