diff --git a/misc/os.sh b/misc/os.sh
new file mode 100755
index 0000000..631365b
--- /dev/null
+++ b/misc/os.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+# This script prints the canonical operating system name used to select the
+# per-OS build configuration and to name the out/<os> results directory.
+# It is normally just uname(1), but some operating systems share a kernel name
+# and have to be told apart by other means.
+case `uname -s` in
+# PureDarwin is an independent reimplementation of the Darwin userland around
+# the same xnu kernel, so it also reports Darwin from uname. It differs enough
+# from macOS in what POSIX it provides that it warrants its own results.
+Darwin)
+  if [ "$(sw_vers -productName 2>/dev/null)" = PureDarwin ]; then
+    echo PureDarwin
+  else
+    echo Darwin
+  fi
+  ;;
+*) uname -s ;;
+esac
