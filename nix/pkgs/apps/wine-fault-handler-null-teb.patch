Die once, not forever, when a fault lands on a thread with no TEB.

--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2386,6 +2386,54 @@
 }
 
 
+static void write_hex( char *p, unsigned long v )
+{
+    int i;
+    for (i = 15; i >= 0; i--, v >>= 4) p[i] = "0123456789abcdef"[v & 0xf];
+}
+
+
+/**********************************************************************
+ *		fault_handler_has_teb
+ *
+ * Check that the faulting thread is one we can service an exception on.
+ *
+ * NtCurrentTeb() is pthread_getspecific( teb_key ), so it comes back NULL once
+ * libpthread's TSD cleanup has run - which happens while a thread is exiting,
+ * before the thread stops executing. Every path out of a fault handler needs
+ * the TEB, so servicing the fault would fault again at the same rip, the
+ * kernel would redeliver, and the process would spin on one instruction
+ * forever. Restore the default action instead and let it die once, so the
+ * fault that actually happened stays visible.
+ */
+static BOOL fault_handler_has_teb( int sig )
+{
+    char msg[] = "wine: fault on a thread with no TEB (mid thread exit?): teb 0000000000000000"
+                 " self 0000000000000000 owner 0000000000000000 key 0000000000000000\n";
+    struct sigaction dfl;
+    struct ntdll_thread_data *thread_data;
+    unsigned long rsp, teb;
+
+    if (NtCurrentTeb()) return TRUE;
+
+    /* Arm the default action before the reads below, so a bad address kills
+     * the process rather than reentering this handler. */
+    memset( &dfl, 0, sizeof(dfl) );
+    dfl.sa_handler = SIG_DFL;
+    sigaction( sig, &dfl, NULL );
+
+    __asm__( "movq %%rsp,%0" : "=r" (rsp) );
+    teb = rsp & ~signal_stack_mask;
+    thread_data = (struct ntdll_thread_data *)((char *)teb + offsetof( TEB, GdiTebBatch ));
+    write_hex( msg + 60, teb );
+    write_hex( msg + 82, (unsigned long)pthread_self() );
+    write_hex( msg + 105, (unsigned long)thread_data->pthread_id );
+    write_hex( msg + 126, (unsigned long)teb_key );
+    write( 2, msg, sizeof(msg) - 1 );
+    return FALSE;
+}
+
+
 /**********************************************************************
  *		segv_handler
  *
