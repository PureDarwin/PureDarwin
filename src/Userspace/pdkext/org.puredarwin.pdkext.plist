<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.puredarwin.pdkext</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/sbin/pdkext</string>
		<string>boot</string>
	</array>
	<key>RunAtLoad</key>
