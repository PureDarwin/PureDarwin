diff --git a/drivers/gpu/drm/drm_os_freebsd.c b/drivers/gpu/drm/drm_os_freebsd.c
index af7ccbbeb3..59bb57516f 100644
--- a/drivers/gpu/drm/drm_os_freebsd.c
+++ b/drivers/gpu/drm/drm_os_freebsd.c
@@ -134,6 +134,14 @@ drm_dev_alias(struct device *ldev, struct drm_minor *minor, const char *minor_st
 	 */
 	snprintf(buf, sizeof(buf), "dri/%s", minor_str);
 	cdevp = linux_find_cdev("drm", DRM_MAJOR, minor->index);
+#ifdef __PUREDARWIN__
+	/* PureDarwin's dri character device makes the node, a cloning one */
+	{
+		extern int pd_drm_dev_node(const char *minor_fmt, int index, struct drm_device *dev);
+		pd_drm_dev_node(minor_str, minor->index, minor->dev);
+		return (0);
+	}
+#endif
 	MPASS(cdevp != NULL);
 	if (cdevp == NULL)
 		return (-ENXIO);
diff --git a/drivers/gpu/drm/drm_prime.c b/drivers/gpu/drm/drm_prime.c
--- a/drivers/gpu/drm/drm_prime.c
+++ b/drivers/gpu/drm/drm_prime.c
@@ -567,6 +567,12 @@ int drm_prime_handle_to_fd_ioctl(struct drm_device *dev, void *data,
 		args->flags = ((args->flags & LINUX_O_CLOEXEC) ? DRM_CLOEXEC : 0)
 			| ((args->flags & LINUX_O_RDWR) ? DRM_RDWR : 0);
 #endif
+#ifdef __PUREDARWIN__
+	/* userspace sends darwin's open flags, the kernel side has haiku's */
+	args->flags = ((args->flags & 0x01000000) ? DRM_CLOEXEC : 0)
+		| ((args->flags & 0x2) ? DRM_RDWR : 0)
+		| (args->flags & ~(0x01000000 | 0x3));
+#endif
 	if (args->flags & ~(DRM_CLOEXEC | DRM_RDWR))
 		return -EINVAL;
 
--- a/drivers/gpu/drm/drm_os_freebsd.c
+++ b/drivers/gpu/drm/drm_os_freebsd.c
@@ -119,7 +119,13 @@
 	node = SYSCTL_ADD_NODE(ctx_list, SYSCTL_STATIC_CHILDREN(_dev_drm), OID_AUTO, buf,
 	    CTLFLAG_RD, NULL, "DRM properties");
 	oid_list = SYSCTL_CHILDREN(node);
+#ifdef __PUREDARWIN__
+	// a device tree platform device has no pci ivars behind its newbus device
+	tmp = device_get_ivars(dev) != NULL ?
+	    pci_get_vendor(dev) + ((u32)pci_get_device(dev) << 16) : 0;
+#else
 	tmp = pci_get_vendor(dev) + ((u32)pci_get_device(dev) << 16);
+#endif
 	SYSCTL_ADD_PROC(ctx_list, oid_list, OID_AUTO, "PCI_ID",
 	    CTLTYPE_STRING | CTLFLAG_RD, NULL, tmp,
 	    sysctl_pci_id, "A", "PCI vendor and device ID");
