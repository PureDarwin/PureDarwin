diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
index 7ee9026107..34426d7de5 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
@@ -193,7 +193,12 @@ uint amdgpu_svm_default_granularity = 9;
  * OverDrive(bit 14) disabled by default
  * GFX DCS(bit 19) disabled by default
  */
+#ifdef __PUREDARWIN__
+/* GFXOFF stays off: CP IBs fail once GC power-gates under PureDarwin */
+uint amdgpu_pp_feature_mask = 0xfff73fff;
+#else
 uint amdgpu_pp_feature_mask = 0xfff7bfff;
+#endif
 uint amdgpu_force_long_training;
 int amdgpu_lbpw = -1;
 int amdgpu_compute_multipipe = -1;
@@ -2392,6 +2397,20 @@ retry_init:
 		drm_client_setup(adev_to_drm(adev), format);
 	}
 
+#ifdef __PUREDARWIN__
+	/* opt-in bring-up client: colour bars on every lit crtc (boot-arg drm_testpattern=1) */
+	{
+		extern long pd_drm_tunable_long(const char *path, long def);
+		extern int pd_drm_test_client(struct drm_device *dev);
+		extern void pd_amdgpu_fb_register(struct drm_device *dev);
+		if (pd_drm_tunable_long("drm.testpattern", 0) != 0)
+			pd_drm_test_client(ddev);
+		else
+			/* the IOFramebuffer brings the display up when it starts */
+			pd_amdgpu_fb_register(ddev);
+	}
+#endif
+
 	ret = amdgpu_debugfs_init(adev);
 	if (ret)
 		DRM_ERROR("Creating debugfs files failed (%d).\n", ret);
