(version 1)

(define (corefoundation)
	;; CFBundle, CFLocale and CFTimeZone data
	(allow file-read*
		(subpath "/usr/share/icu")
		(subpath "/System/Library/CoreServices")
		(literal "/Library/Preferences/.GlobalPreferences.plist")
		(regex #"^/Users/[^/]+/Library/Preferences/\.GlobalPreferences[^/]*\.plist$")
		(regex #"^/private/var/root/Library/Preferences/\.GlobalPreferences[^/]*\.plist$"))
	(allow file-read-metadata
		(literal "/Library")
		(literal "/Library/Preferences")
		(literal "/Users")
		(literal "/private/var/root"))

	;; preferences go through cfprefsd
	(allow user-preference-read
		(preference-domain ".GlobalPreferences")
		(preference-domain "kCFPreferencesAnyApplication"))
	(allow mach-lookup
		(global-name "com.apple.cfprefsd.daemon")
		(global-name "com.apple.cfprefsd.agent")
		(global-name "com.apple.CoreServices.coreservicesd")))
