option('xwayland', type: 'feature', value: 'auto', description: 'Automatic Xwayland handling')
option('input', type: 'combo', value: 'auto', choices: ['auto', 'darwin', 'libinput', 'wscons'], description: 'Input backend to use')
option('video', type: 'combo', value: 'drm', choices: ['drm', 'fb'], description: 'Video backend to use')
option('fb', type: 'combo', value: 'auto', choices: ['auto', 'darwin', 'fbdev', 'wsdisplay'], description: 'Framebuffer interface to use')
option('fbdev-device', type: 'string', value: '/dev/fb0', description: 'Linux framebuffer device')
option('wsdisplay-device', type: 'string', value: '', description: 'wsdisplay framebuffer device (empty uses the VT selected by swc-launch)')
option('udev', type: 'feature', value: 'auto', description: 'libinput libudev support')
option('extra', type: 'boolean', value: true, description: 'Build swc utility applications')
option('example', type: 'boolean', value: false, description: 'Build swc example compositor')
