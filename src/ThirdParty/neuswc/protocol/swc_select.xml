<?xml version="1.0" encoding="UTF-8"?>
<protocol name="swc_select">
    <interface name="swc_select" version="1">
        <description summary="Get a selection box">
            Allows clients to get an interactive selction box.
        </description>

        <request name="grab" />
				<event name="update" >
						<arg name="x1" type="int" />
						<arg name="y1" type="int" />
						<arg name="x2" type="int" />
						<arg name="y2" type="int" />
				</event>

				<event name="done" >
						<arg name="x1" type="int" />
						<arg name="y1" type="int" />
						<arg name="x2" type="int" />
						<arg name="y2" type="int" />
				</event>

				<event name="cancelled" />
				<request name="destroy" type="destructor" />
		</interface>
</protocol>
