// geometric functions in plain arithmetic, as the AIR reference does
template <class V> inline V cross(V a, V b) {
  return a.yzx * b.zxy - a.zxy * b.yzx;
}
template <class V> inline typename __pd_info<V>::elem length(V v) {
  return sqrt(dot(v, v));
}
template <class V> inline typename __pd_info<V>::elem length_squared(V v) {
  return dot(v, v);
}
template <class V> inline typename __pd_info<V>::elem distance(V a, V b) {
  return length(a - b);
}
template <class V> inline V normalize(V v) {
  return v * rsqrt(dot(v, v));
}
template <class V> inline V reflect(V i, V n) {
  return i - 2 * dot(n, i) * n;
}
template <class V> inline V faceforward(V n, V i, V nref) {
  return dot(nref, i) < 0 ? n : -n;
}
