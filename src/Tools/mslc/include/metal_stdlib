struct _sampler_t;

// constexpr sampler arguments, valued as the fields of AIR's 64 bit sampler state they set. The layout is read
// from Apple's metal output (Xcode 26) for samplers with each argument: addresses at 0, 3, 6, mag, min and mip
// filters at 9, 11, 13, coord at 15, compare at 16, anisotropy - 1 at 20, lod clamp halves at 24 and 40, border
// colour at 56. clamp_to_border is address 0 with its border colour, transparent black is clamp_to_zero
enum class coord { normalized = 0, pixel = 1 };
enum class address { clamp_to_zero = 0, clamp_to_edge = 1, repeat = 2, mirrored_repeat = 3, clamp_to_border = 0 };
enum class s_address { clamp_to_zero = 0, clamp_to_edge = 1, repeat = 2, mirrored_repeat = 3, clamp_to_border = 0 };
enum class t_address { clamp_to_zero = 0, clamp_to_edge = 1, repeat = 2, mirrored_repeat = 3, clamp_to_border = 0 };
enum class r_address { clamp_to_zero = 0, clamp_to_edge = 1, repeat = 2, mirrored_repeat = 3, clamp_to_border = 0 };
enum class filter { nearest = 0, linear = 1 };
enum class mag_filter { nearest = 0, linear = 1 };
enum class min_filter { nearest = 0, linear = 1 };
enum class mip_filter { none = 0, nearest = 1, linear = 2 };
enum class compare_func {
  none = 8, less = 1, less_equal = 2, greater = 3, greater_equal = 4, equal = 5, not_equal = 6, always = 7, never = 8
};
enum class border_color { transparent_black = 0, opaque_black = 1, opaque_white = 2 };
struct max_anisotropy {
  int value;
  constexpr max_anisotropy(int v) : value(v) {}
};
struct lod_clamp {
  float lo, hi;
  constexpr lod_clamp(float a, float b) : lo(a), hi(b) {}
};

// the state Apple's compiler gives a constexpr sampler with no arguments: clamp_to_edge on all three axes,
// nearest filters, no mip filter, normalized coordinates, no compare, anisotropy 1, lod clamp 0 to the half maximum
constexpr ulong __pd_sampler_default = 0x007bff0000080049ul;
constexpr ulong __pd_sfield(ulong s, unsigned at, unsigned bits, unsigned v) {
  return (s & ~(((1ul << bits) - 1) << at)) | (ulong)v << at;
}
// a lod as a half, rounded to nearest, clamped to the half maximum as Apple's FLT_MAX default is
constexpr unsigned __pd_lod_half(float f) {
  if (!(f > 0.0f))
    return 0;
  if (f >= 65504.0f)
    return 0x7bff;
  uint u = __builtin_bit_cast(uint, f);
  int e = (int)(u >> 23) - 127 + 15;
  uint m = u & 0x7fffff;
  // below the smallest normal half a lod is 0 for every purpose
  if (e <= 0)
    return 0;
  uint h = (uint)e << 10 | m >> 13;
  return (unsigned)(h + ((m >> 12) & 1));
}
constexpr ulong __pd_sapply(ulong s, coord c) { return __pd_sfield(s, 15, 1, (unsigned)c); }
constexpr ulong __pd_sapply(ulong s, address a) {
  return __pd_sfield(__pd_sfield(__pd_sfield(s, 0, 3, (unsigned)a), 3, 3, (unsigned)a), 6, 3, (unsigned)a);
}
constexpr ulong __pd_sapply(ulong s, s_address a) { return __pd_sfield(s, 0, 3, (unsigned)a); }
constexpr ulong __pd_sapply(ulong s, t_address a) { return __pd_sfield(s, 3, 3, (unsigned)a); }
constexpr ulong __pd_sapply(ulong s, r_address a) { return __pd_sfield(s, 6, 3, (unsigned)a); }
constexpr ulong __pd_sapply(ulong s, filter f) { return __pd_sfield(__pd_sfield(s, 9, 2, (unsigned)f), 11, 2, (unsigned)f); }
constexpr ulong __pd_sapply(ulong s, mag_filter f) { return __pd_sfield(s, 9, 2, (unsigned)f); }
constexpr ulong __pd_sapply(ulong s, min_filter f) { return __pd_sfield(s, 11, 2, (unsigned)f); }
constexpr ulong __pd_sapply(ulong s, mip_filter f) { return __pd_sfield(s, 13, 2, (unsigned)f); }
constexpr ulong __pd_sapply(ulong s, compare_func f) { return __pd_sfield(s, 16, 4, (unsigned)f); }
constexpr ulong __pd_sapply(ulong s, border_color b) { return __pd_sfield(s, 56, 2, (unsigned)b); }
constexpr ulong __pd_sapply(ulong s, max_anisotropy a) {
  return __pd_sfield(s, 20, 4, (unsigned)(a.value < 1 ? 0 : a.value > 16 ? 15 : a.value - 1));
}
constexpr ulong __pd_sapply(ulong s, lod_clamp l) {
  return __pd_sfield(__pd_sfield(s, 24, 16, __pd_lod_half(l.lo)), 40, 16, __pd_lod_half(l.hi));
}

__attribute__((const, nothrow)) __constant _sampler_t *__pd_const_sampler(ulong) __asm__("pd.const_sampler");

struct sampler {
  __constant _sampler_t *__h;
};

// mslc spells constexpr sampler as constexpr __pd_csampler: the state is a constant expression, and the
// sampler it converts to names a __air_sampler_state global, which airify makes from pd.const_sampler(state)
struct __pd_csampler {
  ulong __state;

  template <class... A> constexpr __pd_csampler(A... a) : __state(__pd_sampler_default) {
    ((__state = __pd_sapply(__state, a)), ...);
  }
  operator sampler() const {
    return sampler{ __pd_const_sampler(__state) };
  }
};

inline __constant _sampler_t *__pd_smp(sampler s) {
  return s.__h;
}

struct level {
  float lod;
  explicit level(float l) : lod(l) {}
};
struct bias {
  float value;
  explicit bias(float b) : value(b) {}
};
struct gradient2d {
  float2 dx, dy;
  gradient2d(float2 x, float2 y) : dx(x), dy(y) {}
};
struct min_lod_clamp {
  float value;
  explicit min_lod_clamp(float v) : value(v) {}
};

// calls named pd.sret.air.* return AIR's { texel, i8 } pair: airify restores the pair
template <class T> struct __pd_tex2d;
#define PD_TEX2D(T, t)                                                                                              \
  __attribute__((pure, convergent, nothrow)) vec<T, 4> __pd_sample_2d_##T(__global _texture_2d_t *,                    \
                                                                      __constant _sampler_t *, float2, bool, int2, \
                                                                      bool, float, float, int) __asm__(            \
      "pd.sret.air.sample_texture_2d." t);                                                                        \
  __attribute__((pure, nothrow)) vec<T, 4> __pd_read_2d_##T(__global _texture_2d_t *, uint2, uint, int) __asm__(        \
      "pd.sret.air.read_texture_2d." t);                                                                          \
  __attribute__((nothrow)) void __pd_write_2d_##T(__global _texture_2d_t *, uint2, vec<T, 4>, uint, int) __asm__(      \
      "air.write_texture_2d." t);                                                                         \
  template <> struct __pd_tex2d<T> {                                                                                \
    static vec<T, 4> sample(__global _texture_2d_t *h, __constant _sampler_t *s, float2 c, int2 off, bool lod,     \
                            float v) {                                                                              \
      return __pd_sample_2d_##T(h, s, c, true, off, lod, v, 0.0f, 0);                                               \
    }                                                                                                               \
    static vec<T, 4> read(__global _texture_2d_t *h, uint2 c, uint lod, int a) {                                   \
      return __pd_read_2d_##T(h, c, lod, a);                                                                        \
    }                                                                                                               \
    static void write(__global _texture_2d_t *h, uint2 c, vec<T, 4> v, uint lod, int a) {                          \
      __pd_write_2d_##T(h, c, v, lod, a);                                                                           \
    }                                                                                                               \
  };

// explicit gradients, Apple's shape: coordinate, dPdx, dPdy, min lod, true, offset, 0
