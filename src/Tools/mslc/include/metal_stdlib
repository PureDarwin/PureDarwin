#define PD_TEX2DG(T, t)                                                                                             \
  __attribute__((pure, nothrow)) vec<T, 4> __pd_sample_2dg_##T(__global _texture_2d_t *, __constant _sampler_t *,     \
                                                               float2, float2, float2, float, bool, int2, int)       \
      __asm__("pd.sret.air.sample_texture_2d_grad." t);                                                         \
  template <> struct __pd_tex2dg<T> {                                                                               \
    static vec<T, 4> sample(__global _texture_2d_t *h, __constant _sampler_t *s, float2 c, float2 dx, float2 dy,   \
                            int2 off) {                                                                             \
      return __pd_sample_2dg_##T(h, s, c, dx, dy, 0.0f, true, off, 0);                                              \
    }                                                                                                               \
  };

