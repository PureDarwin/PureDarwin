// unorm packing written out from the MSL specification's conversion rules, no AIR intrinsic involved
inline uint pack_float_to_unorm4x8(float4 v) {
  uint4 u = __builtin_convertvector(clamp(v, 0.0f, 1.0f) * 255.0f + 0.5f, uint4);
  return u.x | u.y << 8 | u.z << 16 | u.w << 24;
}
inline float4 unpack_unorm4x8_to_float(uint p) {
  uint4 u = (uint4)(p & 0xff, p >> 8 & 0xff, p >> 16 & 0xff, p >> 24);
  return __builtin_convertvector(u, float4) / 255.0f;
}
inline uint pack_float_to_unorm2x16(float2 v) {
  uint2 u = __builtin_convertvector(clamp(v, 0.0f, 1.0f) * 65535.0f + 0.5f, uint2);
  return u.x | u.y << 16;
}
inline float2 unpack_unorm2x16_to_float(uint p) {
  uint2 u = (uint2)(p & 0xffff, p >> 16);
  return __builtin_convertvector(u, float2) / 65535.0f;
}
inline float3 unpack_unorm565_to_float(ushort p) {
  uint q = p;
  return (float3)((float)(q >> 11) / 31.0f, (float)(q >> 5 & 0x3f) / 63.0f, (float)(q & 0x1f) / 31.0f);
}
inline ushort pack_float_to_unorm565(float3 v) {
  float3 c = clamp(v, 0.0f, 1.0f);
  return (ushort)((uint)(c.x * 31.0f + 0.5f) << 11 | (uint)(c.y * 63.0f + 0.5f) << 5 | (uint)(c.z * 31.0f + 0.5f));
}

