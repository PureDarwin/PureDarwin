template <class T> inline T select(T a, T b, bool c) {
  return c ? b : a;
}
template <class T, int N> inline vec<T, N> select(vec<T, N> a, vec<T, N> b, vec<int, N> c) {
  vec<T, N> r;
  for (int i = 0; i < N; i++) {
    r[i] = c[i] ? b[i] : a[i];
  }
  return r;
}
template <int N> inline bool any(vec<int, N> c) {
  for (int i = 0; i < N; i++) {
    if (c[i])
      return true;
  }
  return false;
}
template <int N> inline bool all(vec<int, N> c) {
  for (int i = 0; i < N; i++) {
    if (!c[i])
      return false;
  }
  return true;
}
inline bool any(bool c) {
  return c;
}
inline bool all(bool c) {
  return c;
}

// packed vectors: element aligned, converted to and from the vector types
template <class T, int N> struct packed_vec {
  T e[N];

  packed_vec() = default;
  packed_vec(vec<T, N> v) {
    for (int i = 0; i < N; i++) {
      e[i] = v[i];
    }
  }
  operator vec<T, N>() const {
    vec<T, N> v;
    for (int i = 0; i < N; i++) {
      v[i] = e[i];
    }
    return v;
  }
  T &operator[](int i) {
    return e[i];
  }
  const T &operator[](int i) const {
    return e[i];
  }
};
#define PD_PACKED(T)                                                                                                \
