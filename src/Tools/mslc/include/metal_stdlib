// metal::array: a fixed array with bounds-free indexing
template <class T, size_t N> struct array {
  T e[N ? N : 1];

  T &operator[](size_t i) {
    return e[i];
  }
  const T &operator[](size_t i) const {
    return e[i];
  }
  constexpr size_t size() const {
    return N;
  }
};

// matrices: C columns of R rows, column major
template <class T, int C, int R> struct matrix {
  vec<T, R> columns[C];

  matrix() = default;
  explicit matrix(T d) {
    for (int c = 0; c < C; c++) {
      columns[c] = (vec<T, R>)(T)0;
      if (c < R)
        columns[c][c] = d;
    }
  }
  matrix(vec<T, R> c0, vec<T, R> c1) : columns{ c0, c1 } {}
  matrix(vec<T, R> c0, vec<T, R> c1, vec<T, R> c2) : columns{ c0, c1, c2 } {}
  matrix(vec<T, R> c0, vec<T, R> c1, vec<T, R> c2, vec<T, R> c3) : columns{ c0, c1, c2, c3 } {}

  vec<T, R> &operator[](int i) {
    return columns[i];
  }
  const vec<T, R> &operator[](int i) const {
    return columns[i];
  }
};

template <class T, int C, int R> inline vec<T, R> operator*(const matrix<T, C, R> &m, vec<T, C> v) {
  vec<T, R> r = m.columns[0] * v[0];
  for (int c = 1; c < C; c++) {
    r += m.columns[c] * v[c];
  }
  return r;
}
template <class T, int C, int R> inline vec<T, C> operator*(vec<T, R> v, const matrix<T, C, R> &m) {
  vec<T, C> r;
  for (int c = 0; c < C; c++) {
    r[c] = dot(v, m.columns[c]);
  }
  return r;
}
template <class T, int K, int C, int R>
inline matrix<T, C, R> operator*(const matrix<T, K, R> &a, const matrix<T, C, K> &b) {
  matrix<T, C, R> r;
  for (int c = 0; c < C; c++) {
    r.columns[c] = a * b.columns[c];
  }
  return r;
}
template <class T, int C, int R> inline matrix<T, C, R> operator*(const matrix<T, C, R> &m, T s) {
  matrix<T, C, R> r;
  for (int c = 0; c < C; c++) {
    r.columns[c] = m.columns[c] * s;
  }
  return r;
}
template <class T, int C, int R> inline matrix<T, C, R> operator+(const matrix<T, C, R> &a, const matrix<T, C, R> &b) {
  matrix<T, C, R> r;
  for (int c = 0; c < C; c++) {
    r.columns[c] = a.columns[c] + b.columns[c];
  }
  return r;
}
template <class T, int C, int R> inline matrix<T, R, C> transpose(const matrix<T, C, R> &m) {
  matrix<T, R, C> r;
  for (int c = 0; c < C; c++) {
    for (int k = 0; k < R; k++) {
      r.columns[k][c] = m.columns[c][k];
    }
  }
  return r;
}

