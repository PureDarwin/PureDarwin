// atomics: air.atomic.<global|local>.<op>.<s|u>.i32(ptr, value, order, scope, volatile)
enum memory_order { memory_order_relaxed = 0 };
// atomic_int and atomic_uint are clang's OpenCL _Atomic types, same layout

#define PD_ATOMIC(fn, op)                                                                                               \
  __attribute__((nothrow)) uint __pd_atomic_g_##fn##_u(__global uint *, uint, int, int, bool) __asm__(             \
      "air.atomic.global." op ".u.i32");                                                                           \
  __attribute__((nothrow)) int __pd_atomic_g_##fn##_s(__global int *, int, int, int, bool) __asm__(                \
      "air.atomic.global." op ".s.i32");                                                                           \
  __attribute__((nothrow)) uint __pd_atomic_l_##fn##_u(__local uint *, uint, int, int, bool) __asm__(              \
      "air.atomic.local." op ".u.i32");                                                                            \
  __attribute__((nothrow)) int __pd_atomic_l_##fn##_s(__local int *, int, int, int, bool) __asm__(                 \
      "air.atomic.local." op ".s.i32");                                                                            \
  inline uint atomic_##fn##_explicit(device atomic_uint *a, uint v, memory_order o) {                        \
    return __pd_atomic_g_##fn##_u((__global uint *)a, v, o, 2, true);                                        \
  }                                                                                                                 \
  inline int atomic_##fn##_explicit(device atomic_int *a, int v, memory_order o) {                           \
    return __pd_atomic_g_##fn##_s((__global int *)a, v, o, 2, true);                                         \
  }                                                                                                                 \
  inline uint atomic_##fn##_explicit(__local atomic_uint *a, uint v, memory_order o) {                       \
    return __pd_atomic_l_##fn##_u((__local uint *)a, v, o, 1, true);                                         \
  }                                                                                                                 \
  inline int atomic_##fn##_explicit(__local atomic_int *a, int v, memory_order o) {                          \
    return __pd_atomic_l_##fn##_s((__local int *)a, v, o, 1, true);                                          \
  }
