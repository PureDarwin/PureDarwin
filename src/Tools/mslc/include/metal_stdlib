template <class T, int N> using vec = T __attribute__((ext_vector_type(N)));

// element type and lane count (0 for scalars)
template <class T> struct __pd_info {
  typedef T elem;
  static constexpr int lanes = 0;
};
template <class T, int N> struct __pd_info<T __attribute__((ext_vector_type(N)))> {
  typedef T elem;
  static constexpr int lanes = N;
};

template <class A, class B> struct is_same {
  static constexpr bool value = false;
};
template <class A> struct is_same<A, A> {
  static constexpr bool value = true;
};

template <class V, class A> inline void __pd_put(__private V &v, __private int &i, A a) {
  typedef typename __pd_info<V>::elem E;

  if constexpr (__pd_info<A>::lanes == 0)
    v[i++] = (E)a;
  else {
    for (int j = 0; j < __pd_info<A>::lanes; j++) {
      v[i++] = (E)a[j];
    }
  }
}

template <class A> inline A __pd_one(A a) {
  return a;
}

template <class... A> struct __pd_first_lanes {
  static constexpr int value = -1;
  static constexpr bool is_class = false;
};
template <class A> struct __pd_first_lanes<A> {
  static constexpr int value = __pd_info<A>::lanes;
  static constexpr bool is_class = __is_class(A);
};

// T(...) for a vector type T: splat, conversion or concatenation, as MSL's vector constructors
template <class V, class... A> inline V __pd_make(A... a) {
  typedef typename __pd_info<V>::elem E;

  if constexpr (sizeof...(A) == 0)
    return (V)(E)0;
  else if constexpr (__pd_first_lanes<A...>::is_class)
    return (V)__pd_one(a...);
  else if constexpr (__pd_first_lanes<A...>::value == 0)
    return (V)(E)__pd_one(a...);
  else if constexpr (__pd_first_lanes<A...>::value == __pd_info<V>::lanes)
    return __builtin_convertvector(__pd_one(a...), V);
  else {
    V v;
    int i = 0;
    (__pd_put(v, i, a), ...);
    return v;
  }
}

template <class T, class U> inline T as_type(U u) {
  return __builtin_bit_cast(T, u);
}

