template <class T, access A = access::sample> struct texture2d {
  __global _texture_2d_t *__h;

  vec<T, 4> sample(sampler s, float2 c, int2 off = (int2)0) const {
    return __pd_tex2d<T>::sample(__h, __pd_smp(s), c, off, false, 0.0f);
  }
  vec<T, 4> sample(sampler s, float2 c, level l, int2 off = (int2)0) const {
    return __pd_tex2d<T>::sample(__h, __pd_smp(s), c, off, true, l.lod);
  }
  vec<T, 4> sample(sampler s, float2 c, bias b, int2 off = (int2)0) const {
    return __pd_tex2d<T>::sample(__h, __pd_smp(s), c, off, false, b.value);
  }
  vec<T, 4> sample(sampler s, float2 c, gradient2d g, int2 off = (int2)0) const {
    return __pd_tex2dg<T>::sample(__h, __pd_smp(s), c, g.dx, g.dy, off);
  }
  vec<T, 4> read(int2 c, uint lod = 0) const {
    return __pd_tex2d<T>::read(__h, as_type<uint2>(c), lod, (int)A);
  }
  vec<T, 4> read(uint2 c, uint lod = 0) const {
    return __pd_tex2d<T>::read(__h, c, lod, (int)A);
  }
  void write(vec<T, 4> v, uint2 c, uint lod = 0) const {
    __pd_tex2d<T>::write(__h, c, v, lod, (int)A);
  }
  uint get_width(uint lod = 0) const {
    return __pd_width_2d(__h, lod);
  }
  uint get_height(uint lod = 0) const {
    return __pd_height_2d(__h, lod);
  }
};

