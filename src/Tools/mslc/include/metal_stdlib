  explicit level(float l) : lod(l) {}
};
struct bias {
  float value;
  explicit bias(float b) : value(b) {}
};

// calls named pd.sret.air.* return AIR's { texel, i8 } pair: airify restores the pair
template <class T> struct __pd_tex2d;
#define PD_TEX2D(T, t)                                                                                              \
  __attribute__((pure, convergent, nothrow)) vec<T, 4> __pd_sample_2d_##T(__global _texture_2d_t *,                    \
                                                                      __constant _sampler_t *, float2, bool, int2, \
                                                                      bool, float, float, int) __asm__(            \
      "pd.sret.air.sample_texture_2d.v4" t);                                                                        \
  __attribute__((pure, nothrow)) vec<T, 4> __pd_read_2d_##T(__global _texture_2d_t *, uint2, uint, int) __asm__(        \
      "pd.sret.air.read_texture_2d.v4" t);                                                                          \
  __attribute__((nothrow)) void __pd_write_2d_##T(__global _texture_2d_t *, uint2, vec<T, 4>, uint, int) __asm__(      \
      "air.write_texture_2d.v4" t);                                                                         \
  template <> struct __pd_tex2d<T> {                                                                                \
    static vec<T, 4> sample(__global _texture_2d_t *h, __constant _sampler_t *s, float2 c, int2 off, bool lod,     \
                            float v) {                                                                              \
      return __pd_sample_2d_##T(h, s, c, true, off, lod, v, 0.0f, 0);                                               \
    }                                                                                                               \
    static vec<T, 4> read(__global _texture_2d_t *h, uint2 c, uint lod, int a) {                                   \
      return __pd_read_2d_##T(h, c, lod, a);                                                                        \
    }                                                                                                               \
    static void write(__global _texture_2d_t *h, uint2 c, vec<T, 4> v, uint lod, int a) {                          \
      __pd_write_2d_##T(h, c, v, lod, a);                                                                           \
    }                                                                                                               \
  };

PD_TEX2D(float, "f32")
PD_TEX2D(half, "f16")
PD_TEX2D(int, "i32")
PD_TEX2D(uint, "i32")

__attribute__((pure, nothrow)) uint __pd_width_2d(__global _texture_2d_t *, uint) __asm__("air.get_width_texture_2d");
__attribute__((pure, nothrow)) uint __pd_height_2d(__global _texture_2d_t *, uint) __asm__("air.get_height_texture_2d");

template <class T, access A = access::sample> struct texture2d {
  __global _texture_2d_t *__h;

  vec<T, 4> sample(sampler s, float2 c, int2 off = (int2)0) const {
    return __pd_tex2d<T>::sample(__h, s.__h, c, off, false, 0.0f);
  }
  vec<T, 4> sample(sampler s, float2 c, level l, int2 off = (int2)0) const {
    return __pd_tex2d<T>::sample(__h, s.__h, c, off, true, l.lod);
  }
  vec<T, 4> sample(sampler s, float2 c, bias b, int2 off = (int2)0) const {
    return __pd_tex2d<T>::sample(__h, s.__h, c, off, false, b.value);
  }
  vec<T, 4> read(int2 c, uint lod = 0) const {
    return __pd_tex2d<T>::read(__h, as_type<uint2>(c), lod, (int)A);
  }
  vec<T, 4> read(uint2 c, uint lod = 0) const {
    return __pd_tex2d<T>::read(__h, c, lod, (int)A);
  }
  void write(vec<T, 4> v, uint2 c, uint lod = 0) const {
    __pd_tex2d<T>::write(__h, c, v, lod, (int)A);
  }
  uint get_width(uint lod = 0) const {
    return __pd_width_2d(__h, lod);
  }
  uint get_height(uint lod = 0) const {
    return __pd_height_2d(__h, lod);
  }
};

